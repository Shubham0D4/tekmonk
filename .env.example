# =============================================================================
# TekMonk — Environment Variables Template
# =============================================================================
# Copy this file to .env.local and fill in your actual values.
# Never commit .env.local to version control.
#
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser bundle.
# All others are server-only and never reach the client.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (PostgreSQL via Supabase or any Postgres host)
# -----------------------------------------------------------------------------

# Primary connection string used by Prisma (with connection pooling, e.g. pgBouncer).
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true"

# Direct (non-pooled) connection — required for Prisma Migrate.
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# -----------------------------------------------------------------------------
# Better Auth
# -----------------------------------------------------------------------------

# A random 32-byte hex string used to sign sessions and tokens.
# Generate one with: openssl rand -hex 32
BETTER_AUTH_SECRET="replace-me-with-a-32-byte-random-hex-secret"

# The canonical public URL of your app — used by Better Auth for redirects.
BETTER_AUTH_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Site URL
# -----------------------------------------------------------------------------

# Canonical public URL used for Open Graph tags, sitemap, and email links.
# In production this should be your deployed domain (e.g. https://tekmonk.dev).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Supabase Storage
# -----------------------------------------------------------------------------

# Your Supabase project API URL (visible in Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"

# Public anon key — safe to expose to the browser (row-level security enforced).
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Service-role key — server-side only, grants full storage access.
# NEVER expose this to the browser or commit it to git.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Name of the Supabase storage bucket used for blog media (default: blog-media).
SUPABASE_STORAGE_BUCKET="blog-media"

# -----------------------------------------------------------------------------
# SMTP / Email (Gmail App Password recommended)
# -----------------------------------------------------------------------------

# SMTP server hostname.
SMTP_HOST="smtp.gmail.com"

# SMTP server port — 465 for SSL, 587 for STARTTLS.
SMTP_PORT="465"

# Gmail address (or other SMTP account) used to send mail.
SMTP_USER="you@gmail.com"

# Gmail App Password (not your regular password).
# Generate at: https://myaccount.google.com/apppasswords
SMTP_PASS="your-gmail-app-password"

# The "From" display address used in outgoing emails.
SMTP_FROM="TekMonk <you@gmail.com>"

# -----------------------------------------------------------------------------
# Admin Account
# -----------------------------------------------------------------------------

# Email address that will be automatically promoted to the ADMIN role on sign-up.
# Must be lowercase — the app normalises it before comparison.
ADMIN_EMAIL="admin@example.com"
